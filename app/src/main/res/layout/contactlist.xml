<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical">

    <!-- Kept above the list so the system navigation bar and the keyboard never cover it -->
    <LinearLayout
        android:id="@+id/saveitems_ll"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <Button
            android:id="@+id/newitem_bt"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/newitem_bt" />

        <EditText
            android:id="@+id/xls_name_save"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:hint="@string/xls_name_hint"
            android:imeOptions="actionDone"
            android:inputType="text"
            android:maxLines="1"
            android:text="@string/xls_name_save" />

        <Button
            android:id="@+id/saveitems_bt"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/saveitems_bt" />
    </LinearLayout>

    <ListView
        android:id="@+id/lvContactItems"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1" />

</LinearLayout>
